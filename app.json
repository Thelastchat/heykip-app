{
  "expo": {
    "name": "HeyKip",
    "slug": "heykip",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "heykip",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "app.heykip",
      "supportsTablet": false
    },
    "android": {
      "package": "app.heykip",
      "adaptiveIcon": {
        "backgroundColor": "#F6FF9A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "HeyKip uses your photos so you can pin a picture of your goal.",
          "cameraPermission": false,
          "microphonePermission": "HeyKip listens when you tap the mic, so you can tell Kip what you spent."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "HeyKip listens when you tap the mic, so you can tell Kip what you spent.",
          "speechRecognitionPermission": "HeyKip turns what you say into words so Kip can log your spending."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "62199a49-ea06-47da-89ce-b1d52d1f5ad0"
      }
    }
  }
}
